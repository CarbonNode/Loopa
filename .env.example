# ── Loopa configuration ───────────────────────────────────────────────────────
# Copy to .env and fill in. Only ANTHROPIC_API_KEY and SESSION_SECRET are
# required; everything else has a working default.

# ── Core ──────────────────────────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# Public origin the app is served from. Used for invite links and cookie
# security. Set this to your real URL once the tunnel is up.
PUBLIC_URL=https://loopa.example.com

# Signs session cookies. Generate with:  openssl rand -hex 32
# Changing it logs everyone out.
SESSION_SECRET=

# ── Storage ───────────────────────────────────────────────────────────────────
# Where the SQLite database lives.
DATA_DIR=./data
# Where clips and their derived posters/previews live. Point this at a big disk.
MEDIA_DIR=./media

# Reject uploads larger than this (bytes). Default 2 GiB.
MAX_UPLOAD_BYTES=2147483648

# ── AI tagging ────────────────────────────────────────────────────────────────
# 'claude'   — Anthropic API (default). Cheapest capable option.
# 'local'    — an OpenAI-compatible vision endpoint you host yourself.
# 'disabled' — skip tagging entirely; clips are ingested untagged.
TAGGER_PROVIDER=claude

ANTHROPIC_API_KEY=

# Haiku 4.5 is the cheapest vision-capable Claude model: $1/MTok in, $5/MTok
# out — roughly $0.0035 per clip at 6 keyframes. Raise to claude-sonnet-5 for a
# higher-quality re-tag pass; it costs about 3x.
TAGGER_MODEL=claude-haiku-4-5

# Keyframes sampled per clip. Image tokens are (width*height)/750, so each
# 512px-wide frame is ~200 tokens. More frames = better tags, linear cost.
TAGGER_KEYFRAMES=6
# Long edge each keyframe is downscaled to before upload. This is the single
# biggest cost lever — 512 is the sweet spot for recognising a visual gag.
TAGGER_FRAME_WIDTH=512

# For TAGGER_PROVIDER=local — e.g. an Ollama or vLLM server exposing
# /v1/chat/completions with a vision model such as qwen2.5-vl.
LOCAL_TAGGER_URL=http://host.docker.internal:11434/v1
LOCAL_TAGGER_MODEL=qwen2.5-vl:7b

# ── Ingest ────────────────────────────────────────────────────────────────────
# Allow pasting a URL (Reddit / X / YouTube / Imgur / direct file) for
# server-side download via yt-dlp.
ENABLE_URL_INGEST=true
# Refuse remote downloads larger than this (bytes). Default 1 GiB.
MAX_URL_BYTES=1073741824

# ── Workers ───────────────────────────────────────────────────────────────────
# Concurrent ffmpeg jobs. ffmpeg is CPU-hungry; ~1 per 4 cores is sane.
TRANSCODE_CONCURRENCY=3
# Concurrent AI tagging jobs. These are network-bound, so go wider.
TAGGING_CONCURRENCY=4
