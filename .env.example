# ── Loopa configuration ───────────────────────────────────────────────────────
# Copy to .env and fill in. Only ANTHROPIC_API_KEY and SESSION_SECRET are
# required; everything else has a working default.

# ── Core ──────────────────────────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# Public origin the app is served from. Used for invite links and cookie
# security. Set this to your real URL once the tunnel is up.
PUBLIC_URL=https://loopa.example.com

# Signs session cookies. Generate with:  openssl rand -hex 32
# Changing it logs everyone out.
SESSION_SECRET=

# ── Storage ───────────────────────────────────────────────────────────────────
# Where the SQLite database lives.
DATA_DIR=./data
# Where clips and their derived posters/previews live. Point this at a big disk.
MEDIA_DIR=./media

# Reject uploads larger than this (bytes). Default 2 GiB.
MAX_UPLOAD_BYTES=2147483648

# ── AI tagging ────────────────────────────────────────────────────────────────
# 'openrouter' — one key reaches every vendor's vision models (default).
# 'claude'     — Anthropic API directly.
# 'local'      — an OpenAI-compatible vision endpoint you host yourself.
# 'disabled'   — skip tagging entirely; clips are ingested untagged.
#
# A provider selected without its key degrades to 'disabled' rather than
# failing uploads. Re-tag from Settings once the key is set.
TAGGER_PROVIDER=openrouter

# ── OpenRouter (default provider) ─────────────────────────────────────────────
OPENROUTER_API_KEY=
# Measured on a real clip, 6 frames at 512px, cost per clip:
#   qwen/qwen3.7-flash            $0.00011   <- default
#   nex-agi/nex-n2-mini           $0.00012
#   openai/gpt-5.6-luna           $0.00051
#   google/gemini-3.1-flash-lite  $0.00224   (fast, but ~5x the image tokens)
#   anthropic/claude-sonnet-5     $0.00835   (best quality; recognises specifics)
#
# Vendors tokenise images very differently — Gemini charged 7,746 input tokens
# for the same six frames Qwen did in 1,472. Cheap per token is not the same as
# cheap per clip; measure before switching.
OPENROUTER_MODEL=qwen/qwen3.7-flash

# ── Anthropic (TAGGER_PROVIDER=claude) ────────────────────────────────────────
ANTHROPIC_API_KEY=
TAGGER_MODEL=claude-haiku-4-5

# ── Frame sampling (applies to every provider) ────────────────────────────────
# Keyframes sampled per clip. More frames = better tags, linear cost.
TAGGER_KEYFRAMES=6
# Long edge each keyframe is downscaled to. Image tokens scale with area, so
# this is the single biggest cost lever — 512 is the sweet spot for
# recognising a visual gag.
TAGGER_FRAME_WIDTH=512

# For TAGGER_PROVIDER=local — e.g. Ollama or vLLM exposing /v1/chat/completions.
LOCAL_TAGGER_URL=http://host.docker.internal:11434/v1
LOCAL_TAGGER_MODEL=qwen2.5-vl:7b

# ── Ingest ────────────────────────────────────────────────────────────────────
# Allow pasting a URL (Reddit / X / YouTube / Imgur / direct file) for
# server-side download via yt-dlp.
ENABLE_URL_INGEST=true
# Refuse remote downloads larger than this (bytes). Default 1 GiB.
MAX_URL_BYTES=1073741824
# Longest range the clip studio will cut in one go (seconds). The point of the
# studio is grabbing the funny 15 seconds out of a three-hour stream, and an
# unbounded range turns a cheap partial download into a full one.
MAX_CLIP_SECONDS=600
# Cap the source resolution the studio pulls, so a 4K master is not fetched to
# produce a 20-second cut.
MAX_CLIP_HEIGHT=1080

# ── Deployment (read by docker-compose, not by the server) ────────────────────
# Host directories the container mounts. The database is small; the media is
# not, so point MEDIA at a big disk. On super_server that is X:/loopa.
LOOPA_MEDIA_HOST_DIR=./media
LOOPA_DATA_HOST_DIR=./data

# Which host address the published port binds to. Loopback by default, because
# the tunnel reaches the app through a shared network namespace and does not
# need a published port at all. Set 0.0.0.0 to also serve the LAN directly.
LOOPA_BIND_ADDR=127.0.0.1

# Token for the Loopa tunnel, from Cloudflare Zero Trust → Networks → Tunnels →
# Create a tunnel → Docker (copy the value after `--token`). With this set,
# `docker compose up -d` also starts the cloudflared sidecar and the app is
# reachable at the public hostname you route to it. Leave empty for LAN-only.
CLOUDFLARE_TUNNEL_TOKEN=

# ── Workers ───────────────────────────────────────────────────────────────────
# Concurrent ffmpeg jobs. ffmpeg is CPU-hungry; ~1 per 4 cores is sane.
TRANSCODE_CONCURRENCY=3
# Concurrent AI tagging jobs. These are network-bound, so go wider.
TAGGING_CONCURRENCY=4
