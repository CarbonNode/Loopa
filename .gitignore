node_modules/
dist/
*.tsbuildinfo

# Runtime data — never commit the library or the database.
# LEADING SLASH IS LOAD-BEARING: an unanchored `media/` matches at any depth,
# which silently excluded server/src/media/ — the whole media pipeline — from
# every commit. The repo cloned and built, then crashed on a missing module.
/data/
/media/
# Running the server from inside server/ (rather than the repo root) resolves
# the default ./data and ./media relative to *there*, so the same runtime
# artefacts appear one level down. Anchored for the same reason as above.
/server/data/
/server/media/
*.db
*.db-wal
*.db-shm

# Secrets
.env
.env.local
.env.*.local

# Conduit's per-session scratch: pasted uploads and screenshots handed to the
# viewer. Useful in a session, meaningless in the repo.
.conduit/

# Editor / OS noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# Test artifacts
screenshots/
coverage/

# Forge's raw sync output — duplicates assets/concepts/ with generated filenames
assets/forge/

# Vendored standalone yt-dlp zipapp — a 3MB binary, fetched not committed.
# See README: needed on hosts whose sandbox cannot see ~/.local/bin.
/vendor/
